# RUBLI frontend environment variables (Vite). Copy to frontend/.env.local.
# VITE_* values are baked into the bundle at build time: never put secrets here.

# Backend the dev server proxies /api to (dev only, default http://127.0.0.1:8001).
# Point at a remote instance to develop the UI without a local database.
# VITE_API_URL=http://127.0.0.1:8001

# API base path/URL used by the browser (default /api/v1, i.e. same origin).
# VITE_API_BASE_URL=/api/v1

# Canonical public URL used in citation snippets (default: window.location.origin).
# VITE_APP_URL=https://rubli.xyz

# 1 = gate the whole app behind login (must match backend RUBLI_REQUIRE_AUTH).
# VITE_REQUIRE_AUTH=

# Local-dev convenience only: X-Rubli-Key for write endpoints. Do not set in builds.
# VITE_RUBLI_WRITE_KEY=

# Sentry error reporting (optional; empty disables). VITE_GIT_COMMIT tags the release.
VITE_SENTRY_DSN=
# VITE_GIT_COMMIT=
