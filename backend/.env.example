# RUBLI backend environment variables.
# Copy to backend/.env and adjust. The API does not read this file itself:
# `make backend` exports it, Docker Compose passes it via env_file / --env-file,
# or export the variables in your shell. Every variable is optional for local dev.

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite database path (default: backend/RUBLI_NORMALIZED.db). Also read by most
# pipeline scripts and by the test suite (tests needing data skip without it).
# DATABASE_PATH=./RUBLI_NORMALIZED.db
# Query timeout in seconds.
DB_QUERY_TIMEOUT=30

# ── Server ─────────────────────────────────────────────────────────────────────
# dev | production. Outside dev, write endpoints fail closed without
# RUBLI_WRITE_KEY and RUBLI_JWT_SECRET becomes mandatory.
RUBLI_ENV=dev
# Comma-separated allowed origins ('*' is rejected).
CORS_ORIGINS=http://localhost:3009,http://127.0.0.1:3009
# Serve /docs and /redoc (OpenAPI UI).
ENABLE_DOCS=true
# Build identifier shown by /health (set by CI/deploy).
# GIT_COMMIT=unknown

# ── Auth ───────────────────────────────────────────────────────────────────────
# Shared secret for write endpoints (watchlist, feedback, ARIA review), sent as
# X-Rubli-Key. Empty in dev = writes allowed. Generate: openssl rand -hex 32
RUBLI_WRITE_KEY=
# JWT signing secret for user accounts. Empty in dev = random per-process secret.
RUBLI_JWT_SECRET=
# 1 = require login for the whole API (needs RUBLI_JWT_SECRET).
RUBLI_REQUIRE_AUTH=

# ── Optional integrations ──────────────────────────────────────────────────────
# Enables /ai-explain and ARIA memo generation (scripts/aria_generate_memos.py).
ANTHROPIC_API_KEY=
# Error reporting; no-op when empty.
SENTRY_DSN=

# ── ARIA pipeline tuning (scripts/aria_pipeline.py; defaults shown) ─────────────
# ARIA_W_RISK=0.40
# ARIA_W_ENSEMBLE=0.20
# ARIA_W_FINANCIAL=0.20
# ARIA_W_EXTERNAL=0.20
# ARIA_TIER1_THRESHOLD=0.80
# ARIA_TIER2_THRESHOLD=0.60
# ARIA_TIER3_THRESHOLD=0.40
